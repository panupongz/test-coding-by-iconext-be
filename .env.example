# Safe local examples only. Replace passwords in your untracked .env file.
NODE_ENV=development
PORT=3000
TZ=UTC
LOG_LEVEL=info

DB_HOST=mysql
DB_PORT=3306
DB_NAME=iconext_backend
DB_USER=iconext_app
DB_PASSWORD=replace-with-local-password
DB_ROOT_PASSWORD=replace-with-local-root-password
DB_CONNECT_MAX_ATTEMPTS=30
DB_CONNECT_RETRY_MS=1000
